# Awen: copy to .env.local and fill in. Never commit .env.local.

# Supabase (new API keys). The publishable key goes in NEXT_PUBLIC_SUPABASE_ANON_KEY,
# the secret key in SUPABASE_SERVICE_ROLE_KEY (server-only).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Cloudflare R2 (S3 API), private bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=awen-references
# Optional, leave empty: all reads use short-lived presigned URLs
R2_PUBLIC_BASE_URL=

# Gemini API (Google AI Studio), server-only
GEMINI_API_KEY=
# Current stable Flash model on the free tier (Sept 2026). If you hit the daily
# free-tier limit often, try gemini-3.5-flash-lite (higher throughput, lighter).
GEMINI_MODEL=gemini-3.8-flash

# Max AI analyses per user per 24h (all users share one Gemini key/quota).
ANALYSIS_DAILY_LIMIT=100

# Protects the daily cron route (/api/cron/analysis). Any long random string.
CRON_SECRET=
