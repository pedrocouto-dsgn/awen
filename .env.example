# Awen: copy to .env.local and fill in. Never commit .env.local.

# Supabase (new API keys). The publishable key goes in NEXT_PUBLIC_SUPABASE_ANON_KEY,
# the secret key in SUPABASE_SERVICE_ROLE_KEY (server-only).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Cloudflare R2 (S3 API), private bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=awen-references
# Optional, leave empty: all reads use short-lived presigned URLs
R2_PUBLIC_BASE_URL=

# AI analysis provider, server-only. Switching provider is configuration only.
#   gemini      Google AI Studio key from a free-tier project (no billing)
#   openrouter  OpenRouter key, e.g. AI_MODEL=qwen/qwen3-vl-32b-instruct (no YouTube video;
#               YouTube links fall back to the thumbnail)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
AI_API_KEY=
# Optional fallback, used only when the main provider's DAILY quota is used up
# (a per-minute limit just pauses the queue briefly). The main provider takes back
# over on its own once its quota resets. About US$0.0003 per analysis with this model.
AI_FALLBACK_PROVIDER=openrouter
AI_FALLBACK_MODEL=qwen/qwen3-vl-32b-instruct
AI_FALLBACK_API_KEY=
# Legacy names, still read when AI_PROVIDER=gemini and AI_* are empty:
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Multimodal embeddings for semantic and similar-image search (always Gemini).
# The key defaults to GEMINI_API_KEY, or AI_API_KEY when AI_PROVIDER=gemini.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_API_KEY=

# Max AI analyses per user per 24h (all users share one AI key/quota).
ANALYSIS_DAILY_LIMIT=100

# Protects the daily cron route (/api/cron/analysis). Any long random string.
CRON_SECRET=
